{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "financecalendar": {
      "type": "streamable-http",
      "url": "https://www.financecalendar.com/wp-json/fc-mcp/v1/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "calendar:read",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
